{
  "name": "phrasa",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run guard:public-env",
    "dev": "next dev",
    "prebuild": "npm run guard:public-env",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "guard:public-env": "node scripts/guard-public-env.mjs",
    "guard:no-expo": "node scripts/guard-no-expo.mjs",
    "guard:mac-cloud-hygiene": "bash scripts/validate-mac-cloud-hygiene.sh"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
